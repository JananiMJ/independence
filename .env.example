# Copy this file to .env for local development, and add the same values
# as Environment Variables in your hosting provider (Vercel / Netlify / etc).

# Public values (safe to expose in the browser)
VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# Server-side values (used by the enquiry form + /metrics page)
SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
# SECRET — never commit this or put it in a VITE_ variable
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
