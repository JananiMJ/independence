# Copy this file to .env for local development, and add the same values
# as Environment Variables in Hostinger (Web App → Settings → Environment variables).

# Hostinger MySQL database (hPanel → Databases → MySQL Databases)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_enable"
DB_USER="u123456789_enable"
DB_PASSWORD="your-database-password"

# Email (hPanel → Emails → the info@enbl.com.au mailbox)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@enbl.com.au"
SMTP_PASSWORD="your-email-password"
MAIL_TO="info@enbl.com.au"

# Build target for Hostinger
NITRO_PRESET="node-server"
